---
import Layout from '../layouts/Layout.astro';
import OptimizedImage from './OptimizedImage.astro';
import { getEntry } from 'astro:content';
const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing pages/home.md');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = await Promise.all(['research', 'publications', 'notes', 'about'].map(async id => {
  const entry = await getEntry('sections', id);
  if (!entry) throw new Error(`Missing section: ${id}`);
  return {id, title:entry.data.title, description:entry.data.lead || entry.data.preview};
}));
const stops = home.data.career;
---
<Layout level={home.data.level} reading={home.data.reading}>
  <main class="home-scroll" data-home-scroll>
    <div class="home-stage">
      <h1 class="home-title">{home.data.title}</h1>
      <OptimizedImage class="home-landscape home-landscape-motion" src={home.data.image} alt={home.data.imageAlt} fetchpriority="high" loading="eager" />
      <div class="home-journey" data-stops={JSON.stringify(stops)}>
        <svg class="journey-map" aria-hidden="true"></svg>
        <ol class="career-accessible">
          {stops.map(stop => <li>{stop.city}: {stop.title}, {stop.topic}</li>)}
        </ol>
        <nav class="journey-menu" aria-label="Explore the website">
          {sections.map(({id,title},index) => <a class="journey-link" href={`${base}/${id}.html`} data-section-index={index} aria-describedby={`journey-description-${id}`}>
            <span class="journey-label">{title}</span>
            <span class="journey-hover-marker" aria-hidden="true"></span>
          </a>)}
        </nav>
        <div class="journey-descriptions">
          {sections.map(({id,description}) => <p class="journey-description" id={`journey-description-${id}`}>{description}</p>)}
        </div>
      </div>
      <span class="scroll-hint" aria-hidden="true">Scroll to explore <span>↓</span></span>
    </div>
  </main>
</Layout>
<!-- Page-local styles survive Astro history restoration. Title typography is
     unchanged from the original online homepage and inherits the site font. -->
<style is:inline>
  .home-stage { width:min(calc(100% - 48px),1120px); margin:auto; padding:45px 0 80px; background:var(--paper); }
  .home-title { max-width:860px; margin:0 auto; text-align:center; font-size:clamp(48px,9vw,104px); font-weight:400; line-height:.95; letter-spacing:-.055em; }
  .home-landscape { display:block; width:min(560px,100%); height:auto; max-height:48svh; object-fit:contain; margin:44px auto 0; }
  .home-journey { position:relative; margin:64px auto 0; }
  .journey-map { display:none; width:100%; height:var(--journey-map-height,560px); overflow:hidden; }
  .career-accessible { position:absolute; width:1px; height:1px; margin:-1px; padding:0; overflow:hidden; clip-path:inset(50%); }
  .journey-menu { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:0; width:100%; }
  .journey-link { position:relative; display:flex; align-items:flex-start; justify-content:center; min-height:100px; padding:16px 4px 40px; font-size:clamp(22px,3vw,32px); line-height:1.2; letter-spacing:-.02em; color:var(--muted); }
  .journey-label { transition:color .2s ease; }
  .journey-hover-marker { position:absolute; left:50%; top:76px; width:8px; height:8px; border:1.5px solid var(--ink); background:var(--ink); transform:translate(-50%,-50%) rotate(45deg); transition:width .3s ease,height .3s ease,transform .3s ease,background-color .15s ease; pointer-events:none; }
  .journey-link.is-selected .journey-hover-marker { width:26px; height:26px; background:var(--paper); }
  .journey-link.is-selected { color:var(--ink); }
  .journey-descriptions { position:relative; width:min(800px,calc(100% - 64px)); min-height:160px; margin:30px auto 0; }
  .journey-description { position:absolute; inset:0 0 auto; margin:0; color:var(--ink); font-size:19px; line-height:1.55; text-align:justify; text-align-last:left; hyphens:auto; overflow-wrap:break-word; opacity:0; visibility:hidden; transform:translateY(8px); }
  .scroll-hint { display:none; }
  .home-scroll.is-animated { height:calc(220svh + 6000px); margin-top:calc(-1 * var(--site-header-height)); }
  body:has(.home-scroll.is-animated) { padding-bottom:0; }
  .is-animated .home-stage { position:sticky; top:0; height:100svh; padding:0; overflow:hidden; }
  .is-animated .home-title { position:absolute; z-index:3; top:18%; left:50%; width:min(860px,100%); transform:translateX(-50%); transform-origin:center top; }
  .is-animated .home-landscape-motion { position:absolute; top:43%; left:50%; margin:0; transform:translateX(-50%); opacity:.55; }
  .is-animated .home-journey { position:absolute; top:var(--journey-top,110px); left:0; right:0; max-width:1024px; margin:0 auto; opacity:0; }
  .is-animated .journey-map { display:block; }
  .is-animated .journey-menu { position:absolute; inset:calc(var(--journey-line-y,275px) - 76px) 0 auto; }
  .is-animated .journey-link { opacity:0; visibility:hidden; }
  .is-animated .journey-hover-marker { opacity:0; }
  .is-animated .journey-descriptions { position:absolute; top:calc(var(--journey-line-y,275px) + 40px); left:50%; transform:translateX(-50%); margin:0; overflow-y:auto; overscroll-behavior:contain; }
  .is-animated .scroll-hint { display:block; position:absolute; bottom:38px; left:50%; transform:translateX(-50%); color:var(--muted); font-size:13px; letter-spacing:.04em; }
  .scroll-hint span { margin-left:12px; }
  .journey-land { fill:none; stroke:var(--muted); stroke-opacity:.35; stroke-width:.8; stroke-linejoin:round; }
  .journey-route { fill:none; stroke:var(--ink); stroke-width:1.7; stroke-linecap:round; }
  .journey-pin { fill:var(--ink); }
  .journey-ring { fill:var(--paper); stroke:var(--ink); stroke-width:1.5; }
  .journey-career text { paint-order:stroke; stroke:var(--paper); stroke-width:6; stroke-linejoin:round; }
  .journey-city { fill:var(--muted); font-size:14px; font-style:italic; }
  .journey-role { fill:var(--ink); font-size:21px; letter-spacing:-.02em; }
  .journey-topic { fill:var(--muted); font-size:14px; }
  .journey-leader { fill:none; stroke:var(--muted); stroke-opacity:.5; stroke-width:.65; }
  @media(max-width:700px) {
    .home-stage { width:calc(100% - 36px); }
    .home-title { font-size:clamp(44px,11vw,66px); }
    .home-journey { margin-top:44px; }
    .journey-menu { grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px 0; }
    .journey-link { font-size:25px; }
    .journey-descriptions { width:100%; min-height:190px; }
  }
  @media(prefers-reduced-motion:reduce) { .journey-hover-marker,.journey-label { transition:none; } }
  .is-animated.is-compact .journey-menu { grid-template-columns:repeat(4,minmax(0,1fr)); gap:0; top:calc(var(--journey-line-y) - 96px); }
  .is-animated.is-compact .journey-link { min-height:120px; padding:0; }
  .is-animated.is-compact .journey-label { position:absolute; top:4px; left:50%; transform:translateX(-50%); width:calc(200% - 12px); text-align:center; }
  .is-animated.is-compact .journey-link:nth-child(even) .journey-label { top:38px; }
  .is-animated.is-compact .journey-link:first-child .journey-label { left:4px; transform:none; text-align:left; }
  .is-animated.is-compact .journey-link:last-child .journey-label { left:auto; right:4px; transform:none; text-align:right; }
  .is-animated.is-compact .journey-hover-marker { top:96px; }
  .is-animated.is-compact .journey-descriptions { width:calc(100% - 16px); }
  .is-compact .journey-description { font-size:17px; line-height:1.5; }
  .is-compact .journey-city { font-size:13px; }
  .is-compact .journey-role { font-size:16px; }
  .is-compact .journey-topic { font-size:12px; }
  /* Phones use a vertical rail, with full-size titles to the right. */
  .is-vertical .journey-menu { display:flex; flex-direction:column; gap:0; }
  .is-animated.is-vertical .journey-menu { top:calc(var(--journey-line-start) - 22px); }
  .is-vertical .journey-link,
  .is-animated.is-vertical .journey-link { flex:none; min-height:0; height:var(--journey-step-gap,76px); padding:0; justify-content:flex-start; }
  .is-vertical .journey-link:nth-child(n) .journey-label,
  .is-animated.is-vertical .journey-link:nth-child(n) .journey-label { position:absolute; top:7px; left:62px; right:0; width:auto; transform:none; text-align:left; }
  .is-vertical .journey-hover-marker,
  .is-animated.is-vertical .journey-hover-marker { left:var(--journey-line-x,24px); top:22px; }
  .is-vertical .journey-descriptions,
  .is-animated.is-vertical .journey-descriptions { width:calc(100% - 78px); margin-left:62px; }
  .is-animated.is-vertical .journey-descriptions { top:var(--journey-description-top); left:0; transform:none; }
  .is-vertical:not(.is-animated) .journey-menu::before { content:''; position:absolute; top:22px; left:24px; height:calc(3 * var(--journey-step-gap,76px)); width:1.7px; background:var(--ink); }
</style>
<script>
  import { initializeHomepage } from '../scripts/homepage-journey.js';
  let cleanup = () => {};
  const initialize = () => { cleanup(); cleanup = initializeHomepage(); };
  document.addEventListener('astro:before-swap', () => cleanup());
  document.addEventListener('astro:page-load', initialize);
  initialize();
</script>
