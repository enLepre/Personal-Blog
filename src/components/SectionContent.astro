---
import { getCollection, getEntry, render } from 'astro:content';
import { articleHref } from '../lib/urls.mjs';
import { newestFirst } from '../lib/sort.mjs';
const { section, previewOnly = false } = Astro.props;
const intro = await getEntry('sections', section);
if (!intro) throw new Error(`Missing section: ${section}`);
const entries = section === 'about' ? [] : newestFirst(await getCollection(section));
const About = section === 'about' && !previewOnly ? (await render(intro)).Content : null;
---
<p class="lead">{intro.data.lead}</p>
{section === 'about' ? <div class="about-content prose">{About ? <About /> : intro.data.preview && <p>{intro.data.preview}</p>}</div> : section === 'notes' ? (
  <ul class="note-list">
    {entries.map(entry => <li data-date={entry.data.date.toISOString()}><div><a href={articleHref(section, entry.id, import.meta.env.BASE_URL)}>{entry.data.title}</a>{entry.data.preview && <div class="prose"><p>{entry.data.preview}</p></div>}</div><span>{entry.data.status}</span></li>)}
  </ul>
) : entries.map(entry => <section class="item" data-date={entry.data.date.toISOString()}><h2><a href={articleHref(section, entry.id, import.meta.env.BASE_URL)}>{entry.data.title}</a></h2>{entry.data.preview && <div class="prose"><p>{entry.data.preview}</p></div>}</section>)}
