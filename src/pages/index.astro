---
import { getEntry } from 'astro:content';
import OriginalHomepage from '../components/OriginalHomepage.astro';
import AnimatedHomepage from '../components/AnimatedHomepage.astro';
const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing pages/home.md');
---
{home.data.homepageAnimation ? <AnimatedHomepage /> : <OriginalHomepage />}
