---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing pages/home.md');
const { Content } = await render(home);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout level={home.data.level}>
  <main>
    <section class="hero shell" aria-labelledby="home-title">
      <div class="hero-inner">
        <h1 class="page-title" id="home-title">{home.data.title}</h1>
        <div class="page-content">
          <img class="landscape" src={`${base}${home.data.image}`} alt={home.data.imageAlt}>
        </div>
        <div class="prose"><Content /></div>
      </div>
    </section>
  </main>
</Layout>
