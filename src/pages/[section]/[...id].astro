---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Publications from '../../components/Publications.astro';
export async function getStaticPaths() {
  const sections = ['research', 'notes', 'essays'] as const;
  const routes = await Promise.all(sections.map(async section =>
    (await getCollection(section)).map(entry => ({
      params: { section, id: entry.id }, props: { entry, section }
    }))
  ));
  return routes.flat();
}
const { entry, section } = Astro.props;
const { Content } = await render(entry);
const parent = await getEntry('sections', section);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout section={section} title={entry.data.title} level={entry.data.level} reading={entry.data.reading}>
  <main class="page article-page">
    <a class="back-link" href={`${base}/${section}.html`}>← {parent?.data.title || section}</a>
    <article>
      <h1 class="page-title">{entry.data.title}</h1>
      <div class="prose"><Content /></div>
      {entry.data.publications && <Publications />}
    </article>
  </main>
</Layout>
