---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import SectionContent from '../components/SectionContent.astro';
export function getStaticPaths() {
  return ['research', 'notes', 'essays', 'about'].map(section => ({ params: { section } }));
}
const { section } = Astro.params;
const entry = await getEntry('sections', section!);
if (!entry) throw new Error(`Missing section Markdown: ${section}`);
---
<Layout section={section} title={entry.data.title} level={entry.data.level}>
  <main class="page">
    <h1 class="page-title">{entry.data.title}</h1>
    <div class="page-content"><SectionContent section={section} /></div>
  </main>
</Layout>
