---
import '../styles/global.css';
import themeScript from '../scripts/theme.js?raw';
import LandscapeFilter from '../components/LandscapeFilter.astro';
import { getEntry, getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
const movement = {
  old: { name: 'page-up-out', duration: '650ms', easing: 'cubic-bezier(.65,0,.25,1)', fillMode: 'both' },
  new: { name: 'page-up-in', duration: '650ms', easing: 'cubic-bezier(.65,0,.25,1)', fillMode: 'both' }
};
const reverseMovement = {
  old: { ...movement.old, name: 'page-down-out' },
  new: { ...movement.new, name: 'page-down-in' }
};
const pageTransition = { forwards: movement, backwards: reverseMovement };
const { section = 'home', title, level, reading = false } = Astro.props;
const homeEntry = await getEntry('pages', 'home');
if (!homeEntry) throw new Error('Missing pages/home.md');
const sections = await getCollection('sections');
const sectionTitle = (id: string) => sections.find(entry => entry.id === id)?.data.title || id;
const home = section === 'home';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const menuItems = ['research', 'publications', 'notes', 'about'].map(id => ({
  id,
  label: sectionTitle(id),
  href: `${base}/${id}.html`,
}));
---
<!doctype html>
<html lang="en">
<head>
  <ClientRouter />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <script is:inline set:html={themeScript}></script>
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} sizes="any" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <title>{home ? homeEntry.data.title : `${title || sectionTitle(section)} — ${homeEntry.data.title}`}</title>
  <meta name="description" content="Research and notes by Enrico Lepre." />
</head>
<body id="top" data-page={section} data-page-level={level} data-reading={String(reading)}>
  <LandscapeFilter />
  <header class="site-header shell" transition:name="site-menu" transition:animate="none">
    <div class="menu">
      <button class="menu-toggle" aria-expanded="false" aria-controls="main-menu" aria-label="Open navigation"><span aria-hidden="true"></span></button>
      <nav id="main-menu" aria-label="Main navigation" inert>
        <a class="brand" href={`${base}/`} data-nav="home">{homeEntry.data.menuTitle}</a>
        {menuItems.map(({ id, label, href }) => {
          const active = !home && id === section;
          return <a href={href} data-nav={id} class:list={{ 'is-active': active }} aria-current={active ? 'page' : undefined}>{label}</a>;
        })}
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark mode">
          <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
          </svg>
          <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.9 13.1A9 9 0 0 1 10.9 3.1a9 9 0 1 0 10 10Z" />
          </svg>
        </button>
      </nav>
    </div>
  </header>
  <div class="page-stage" transition:name="page-content" transition:animate={pageTransition}><slot /></div>
  <footer class="site-footer" transition:name="site-footer" transition:animate="none">{homeEntry.data.footer}</footer>
  <script>import '../scripts/navigation.js'; import '../scripts/external-links.js';</script>
</body>
</html>
