---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
const movement = {
  old: { name: 'page-up-out', duration: '650ms', easing: 'cubic-bezier(.65,0,.25,1)', fillMode: 'both' },
  new: { name: 'page-up-in', duration: '650ms', easing: 'cubic-bezier(.65,0,.25,1)', fillMode: 'both' }
};
const pageTransition = { forwards: movement, backwards: movement };
const { section = 'home', title } = Astro.props;
const home = section === 'home';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
<head>
  <ClientRouter />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <meta name="generator" content={Astro.generator} />
  <title>{title ? `${title} — Enrico Lepre` : home ? 'Enrico Lepre' : `${section[0].toUpperCase() + section.slice(1)} — Enrico Lepre`}</title>
  <meta name="description" content="Research, notes and essays by Enrico Lepre." />
</head>
<body id="top" data-page={section}>
  <header class="site-header shell" transition:name="site-menu" transition:animate="none">
    <div class="menu">
      <button class="menu-toggle" aria-expanded="false" aria-controls="main-menu">Menu <span aria-hidden="true">+</span></button>
      <nav id="main-menu" aria-label="Main navigation" inert>
        <a class="brand" href={`${base}/`} data-nav="home">Enrico Lepre</a>
        {['research', 'notes', 'essays', 'about'].map(id => <a href={`${base}/${id}.html`} data-nav={id} class:list={{ 'is-active': !home && id === section }} aria-current={!home && id === section ? 'page' : undefined}>{id[0].toUpperCase() + id.slice(1)}</a>)}
      </nav>
    </div>
  </header>
  <div class="page-stage" transition:name="page-content" transition:animate={pageTransition}><slot /></div>
  <footer class="site-footer" transition:name="site-footer" transition:animate="none">Enrico Lepre · personal academic notebook</footer>
  <script>import '../scripts/navigation.js';</script>
</body>
</html>
